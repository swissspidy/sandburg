{
  "name": "monorepo-workspaces",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo-workspaces",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "version": "1.0.0",
      "dependencies": {
        "@acme/format": "file:../../shared/format",
        "@acme/greet": "^1.0.0",
        "ms": "^2.1.1"
      }
    },
    "node_modules/@acme/format": {
      "resolved": "shared/format",
      "link": true
    },
    "node_modules/@acme/greet": {
      "resolved": "packages/greet",
      "link": true
    },
    "node_modules/ms": {
      "version": "2.1.2",
      "resolved": "https://registry.npmjs.org/ms/-/ms-2.1.2.tgz",
      "integrity": "sha512-sGkPx+VjMtmA6MX27oA4FBFELFCZZ4S4XqeGOXCv68tT+jb3vk/RyaKWP0PTKyWtmLSM0b+adUTEvbs1PEaH2w==",
      "license": "MIT"
    },
    "node_modules/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/greet": {
      "name": "@acme/greet",
      "version": "1.0.0",
      "dependencies": {
        "ms": "^2.1.0"
      }
    },
    "shared/format": {
      "name": "@acme/format",
      "version": "0.1.0"
    }
  }
}
