{
  "name": "monorepo-workspaces",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "monorepo-workspaces",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "version": "1.0.0",
      "dependencies": {
        "@acme/format": "file:../../shared/format",
        "@acme/greet": "^1.0.0",
        "ms": "^2.1.3"
      }
    },
    "node_modules/@acme/format": {
      "resolved": "shared/format",
      "link": true
    },
    "node_modules/@acme/greet": {
      "resolved": "packages/greet",
      "link": true
    },
    "node_modules/ms": {
      "version": "2.1.3",
      "resolved": "https://registry.npmjs.org/ms/-/ms-2.1.3.tgz",
      "integrity": "sha512-6FlzubTLZG3J2a/NVCAleEhjzq5oxgHyaCU9yYXvcLsvoVaHJq/s5xXI6/XXP6tz7R9xAOtHnSO/tXtF3WRTlA==",
      "license": "MIT"
    },
    "node_modules/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/greet": {
      "name": "@acme/greet",
      "version": "1.0.0",
      "dependencies": {
        "ms": "^2.1.3"
      }
    },
    "shared/format": {
      "name": "@acme/format",
      "version": "0.1.0"
    }
  }
}
