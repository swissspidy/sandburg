---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
body {
  font-family: system-ui, sans-serif;
  margin: 0;
}

main {
  max-width: 40rem;
  margin: 2rem auto;
  padding: 0 1rem;
}

section {
  margin-bottom: 1.5rem;
}
</style>
