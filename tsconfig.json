{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "scripts/pages",
    "lint",
    "scripts/profile.ts",
    "scripts/edit-loop.ts",
    "scripts/split-module.ts",
    "scripts/split-worker.ts",
    "scripts/split-page-checks.ts",
    "scripts/split-session.ts",
    "scripts/split-node-adapter.ts",
    "scripts/test-times.ts",
    "pages/compile.ts",
    "pages/generate",
    "evals",
    "integrations/harbor/build-tasks.ts",
    "fixtures/vite-react-counter/checks.spec.ts",
    "scripts/code-stats.ts",
    "scripts/api-report.ts"
  ]
}
