{
  "name": "sandburg",
  "version": "0.2.0",
  "description": "Run and test generated web apps inside the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sandburg": "./bin/sandburg.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware && knip --no-progress",
    "test": "node --test --test-reporter=spec test/unit/*.test.ts",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 test/e2e/*.test.ts",
    "spike": "node bin/sandburg.js run fixtures/vite-react-counter --checks fixtures/vite-react-counter/checks.spec.ts",
    "test:runtime": "node --test --test-reporter=spec test/runtime/*.test.ts",
    "test:pack": "node --test --test-reporter=spec test/pack/*.test.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "@napi-rs/wasm-runtime": "^1.2.4",
    "@pkgjs/parseargs": "^0.11.0",
    "@playwright/test": "1.64.1",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@testing-library/user-event": "^14.6.7",
    "acorn": "^8.18.0",
    "assert": "^2.1.0",
    "axe-core": "^4.13.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "0.28.2",
    "events": "^3.3.0",
    "ivya": "^1.8.2",
    "path-browserify": "^1.0.1",
    "playwright-core": "1.64.1",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "readable-stream": "^4.7.0",
    "semver": "7.8.5",
    "sha.js": "^2.4.12",
    "string_decoder": "^1.3.0",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "@types/semver": "7.8.0",
    "knip": "^6.43.0",
    "oxc-parser": "^0.155.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissspidy/sandburg.git"
  },
  "homepage": "https://github.com/swissspidy/sandburg#readme",
  "bugs": {
    "url": "https://github.com/swissspidy/sandburg/issues"
  },
  "allowScripts": {
    "esbuild": false
  }
}
