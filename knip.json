{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "scripts/**/*.ts",
    "pages/**/*.{ts,js}",
    "test/**/*.test.ts",
    "evals/**/*.ts",
    "integrations/harbor/*.ts",
    "src/node-runtime/worker.ts",
    "src/node-runtime/globals-shim.ts",
    "src/node-runtime/lib-globals.js",
    "src/node-runtime/process-alias.cjs",
    "src/node-runtime/url-querystring.cjs",
    "src/host/host.ts",
    "src/adapters/node/browser.ts",
    "src/adapters/node/compile-worker.ts",
    "src/adapters/node/sw.js",
    "src/adapters/node/ws-shim.js",
    "src/page-checks/runtime.ts",
    "src/page-checks/dom-shim.ts",
    "lint/*.ts"
  ],
  "project": [
    "src/**/*.{ts,js,cjs}",
    "scripts/**/*.ts",
    "pages/**/*.{ts,js}",
    "test/**/*.ts",
    "evals/**/*.ts",
    "integrations/harbor/*.ts",
    "bin/*.js",
    "lint/*.ts"
  ],
  "ignoreDependencies": [
    "assert",
    "buffer",
    "events",
    "string_decoder",
    "url",
    "util",
    "@napi-rs/wasm-runtime",
    "@npmcli/arborist",
    "npm-package-arg",
    "pacote",
    "cacache",
    "npm-registry-fetch"
  ],
  "ignoreBinaries": [
    "openssl"
  ],
  "ignoreUnresolved": [
    "./lib/npm.js"
  ],
  "ignore": [
    "fixtures/**"
  ]
}
