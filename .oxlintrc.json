{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "fixtures/**",
    "corpus/**",
    "integrations/harbor/tasks/**",
    "dist/**",
    "dist-pages/**",
    ".sandburg/**"
  ],
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "it",
              "describe",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/no-useless-default-assignment": "error",
    "eslint/no-fallthrough": "error",
    "eslint/eqeqeq": [
      "error",
      "smart"
    ],
    "eslint/no-self-compare": "error",
    "eslint/no-new-func": "error",
    "eslint/no-eval": "error",
    "typescript/no-implied-eval": "error",
    "typescript/unbound-method": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-base-to-string": "off",
    "typescript/no-redundant-type-constituents": "off",
    "typescript/no-meaningless-void-operator": "off",
    "promise/no-callback-in-promise": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "eslint/no-control-regex": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:vm",
            "message": "node:vm is not a security boundary: no app code runs on the host (ADR 0001)."
          },
          {
            "name": "vm",
            "message": "node:vm is not a security boundary: no app code runs on the host (ADR 0001)."
          },
          {
            "name": "node:child_process",
            "message": "The host starts processes in a few reviewed places (npm with --ignore-scripts, docker): add a file to the list in .oxlintrc.json only after review."
          },
          {
            "name": "child_process",
            "message": "The host starts processes in a few reviewed places (npm with --ignore-scripts, docker): add a file to the list in .oxlintrc.json only after review."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/node-runtime/**",
        "src/page-checks/runtime.ts",
        "test/**"
      ],
      "rules": {
        "eslint/no-new-func": "off",
        "eslint/no-eval": "off",
        "typescript/no-implied-eval": "off"
      }
    },
    {
      "files": [
        "src/adapters/node/install.ts",
        "src/adapters/node/package-store.ts",
        "src/adapters/node/resolver.ts",
        "src/reference/docker.ts",
        "scripts/**",
        "test/**",
        "integrations/harbor/fence.mjs"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:vm",
                "message": "node:vm is not a security boundary: no app code runs on the host (ADR 0001)."
              },
              {
                "name": "vm",
                "message": "node:vm is not a security boundary: no app code runs on the host (ADR 0001)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "test/**"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/node-runtime/**",
        "src/host/**",
        "src/page-checks/runtime.ts",
        "src/page-checks/dom-shim.ts",
        "src/adapters/node/browser.ts",
        "src/adapters/node/process.ts",
        "src/adapters/node/compile-worker.ts",
        "src/adapters/node/warmup.ts",
        "src/adapters/node/sw.js",
        "src/adapters/node/ws-shim.js"
      ],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*"
                ],
                "message": "This file runs in the browser: Node's modules are the runtime's own (src/node-runtime/builtins), not imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/node-runtime/bundle.ts",
        "src/node-runtime/polyfills.d.ts",
        "src/node-runtime/bundle-cache.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
